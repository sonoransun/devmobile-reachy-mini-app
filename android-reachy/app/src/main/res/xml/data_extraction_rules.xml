<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive files from cloud backup -->
        <exclude domain="sharedpref" path="auth_prefs.xml" />
        <exclude domain="database" path="reachy_database" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive files from device transfer -->
        <exclude domain="sharedpref" path="auth_prefs.xml" />
        <exclude domain="database" path="reachy_database" />
    </device-transfer>
</data-extraction-rules>