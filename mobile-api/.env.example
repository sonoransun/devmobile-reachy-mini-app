# Reachy Mini Mobile API Environment Configuration

# Server Configuration
NODE_ENV=development
API_PORT=3001

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/reachy_mobile_api

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379

# Robot Daemon Configuration
ROBOT_DAEMON_URL=http://localhost:8000

# Logging Configuration
LOG_LEVEL=info

# External Services
HUGGINGFACE_API_URL=https://huggingface.co
POSTHOG_API_KEY=your-posthog-api-key
POSTHOG_HOST=https://eu.posthog.com

# CORS Configuration (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,capacitor://localhost

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=10
ROBOT_CONTROL_RATE_LIMIT_MAX=120

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=60000

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS_PER_DEVICE=3

# File Upload Configuration
MAX_FILE_SIZE=10485760
MAX_FILES=5

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret

# Development/Debug
DEBUG=reachy-mobile-api:*
SWAGGER_ENABLED=true