# Reachy Mini Mobile API Environment Configuration

# Server Configuration
NODE_ENV=development
API_PORT=3001

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production-128-chars-long
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production-256-chars
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d

# Robot Daemon Configuration
ROBOT_DAEMON_HOST=localhost
ROBOT_DAEMON_PORT=8000
ROBOT_DAEMON_TIMEOUT=30000

# Database Configuration (Optional - will use in-memory fallback)
DATABASE_URL=postgresql://username:password@localhost:5432/reachy_mobile_api
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reachy_mobile_api
DB_USER=username
DB_PASSWORD=password

# Redis Configuration (Optional - will use in-memory fallback)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# VPN Configuration
VPN_CONFIG_DIR=/tmp/reachy-vpn
VPN_LOG_DIR=/tmp/reachy-vpn-logs

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Features
ENABLE_METRICS=true
ENABLE_RATE_LIMITING=true
ENABLE_CORS=true

# External APIs
HUGGING_FACE_TOKEN=your-hugging-face-token-here
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302

# Development
DEBUG=false