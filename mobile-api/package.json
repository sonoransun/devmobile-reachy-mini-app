{
  "name": "reachy-mini-mobile-api",
  "version": "1.0.0",
  "description": "Comprehensive REST API for mobile control of Reachy Mini robots via VPN",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:load": "artillery run tests/load/basic-load.yml",
    "test:security": "npm run test:unit -- --testPathPattern=security",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "build": "npm run lint && npm test",
    "docker:build": "docker build -t reachy-mobile-api .",
    "docker:run": "docker run -p 3001:3001 reachy-mobile-api",
    "docs:generate": "echo 'OpenAPI docs available at /docs endpoint when server is running'"
  },
  "keywords": [
    "reachy",
    "robot",
    "mobile",
    "api",
    "rest",
    "vpn",
    "cross-platform"
  ],
  "author": "Reachy Mini Mobile API Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.1",
    "ws": "^8.14.2",
    "socket.io": "^4.7.4",
    "axios": "^1.6.2",
    "redis": "^4.6.11",
    "pg": "^8.11.3",
    "sequelize": "^6.35.1",
    "protobufjs": "^7.2.5",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "prom-client": "^15.0.0",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0",
    "dotenv": "^16.3.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "prettier": "^3.1.0",
    "artillery": "^2.0.3",
    "@types/jest": "^29.5.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pollen-robotics/reachy-mini-mobile-api.git"
  },
  "bugs": {
    "url": "https://github.com/pollen-robotics/reachy-mini-mobile-api/issues"
  },
  "homepage": "https://github.com/pollen-robotics/reachy-mini-mobile-api#readme"
}